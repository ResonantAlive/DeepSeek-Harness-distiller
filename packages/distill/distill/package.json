{
  "name": "@deepseek-ai/dsh-distill",
  "description": "Distillation runner: load task definitions, run independent attempts against a teacher, capture the trajectory in real time, judge it objectively, and write the labelled dataset",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/distill/distill"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "@deepseek-ai/dsh-distill-trajectory-events": "workspace:*",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "@deepseek-ai/dsh-distill-trajectory-events": "workspace:*",
    "@types/js-yaml": "^4.0.9"
  }
}
